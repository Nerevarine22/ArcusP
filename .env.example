# Private server-side Heisenberg API key. Never use a NEXT_PUBLIC_ prefix.
HEISENBERG_API_KEY=

# Enable only TxFlow pages/API without restoring the project chooser.
TXFLOW_ENABLED=false

# The project chooser is enabled by default. Set false to hide it; rebuild after changing.
NEXT_PUBLIC_MULTI_EXCHANGE_ENABLED=true

# Private Neon PostgreSQL pooled connection string for automatic wallet research storage.
# Run npm run research:init after connecting the database. Never use NEXT_PUBLIC_.
DATABASE_URL=
