{
  "name": "arcus-points-checker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "research:init": "node --env-file-if-exists=.env.local scripts/research-db.mjs init",
    "research:export": "node --env-file-if-exists=.env.local scripts/research-db.mjs export",
    "research:delete": "node --env-file-if-exists=.env.local scripts/research-db.mjs delete"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lenis": "^1.3.26",
    "lossless-json": "^4.3.1",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
